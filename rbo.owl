    <!-- http://purl.obolibrary.org/obo/OBI_0000456 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000456">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000005"/>
