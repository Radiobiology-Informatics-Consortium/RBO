        <oboInOwl:hasExactSynonym>blood cell biosynthesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>blood cell formation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>haemopoiesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>hematopoiesis</oboInOwl:hasExactSynonym>
