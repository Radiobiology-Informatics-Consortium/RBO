        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/House</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000418 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000418">
