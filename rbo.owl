        <owl:annotatedTarget>Skeletal element that forms around the notochord and is part of the vertebral column.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="http://dx.plos.org/10.1371/journal.pone.0051070"/>
        <oboInOwl:hasDbXref rdf:resource="https://github.com/obophenotype/uberon/issues/294"/>
