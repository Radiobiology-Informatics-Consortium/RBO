        <oboInOwl:hasDbXref>GOC:tfm</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ISBN:0323052908</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:22426062</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:4711263</oboInOwl:hasDbXref>
    </owl:Axiom>
