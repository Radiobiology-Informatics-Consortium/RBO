    </rdf:Description>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0010058">
        <obo:IAO_0000115>Derived unit which is equal to the total kinetic energy of an atomic nucleus in MeV divided by the number of nucleons in the nucleus</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>MeV/nucleon</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;Derived unit which is equal to the total kinetic energy of an atomic nucleus in MeV divided by the number of nucleons in the nucleus&quot; []</rdfs:comment>
        <rdfs:label>megaelectronvolt per nucleon</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0010059">
        <obo:IAO_0000115>A derived unit equal to the energy deposited by ionizing radiation per micron of path length in matter</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>keV/micron</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A derived unit equal to the energy deposited by ionizing radiation per micron of path length in matter&quot; []</rdfs:comment>
        <rdfs:label>kiloelectronvolt per micron</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0010060">
        <obo:IAO_0000115>A derived absorbed dose unit which is equal to one gray absorbed per minute.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Gy/min</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A derived absorbed dose unit which is equal to one gray absorbed per minute.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>gray per minute</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0010060"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A derived absorbed dose unit which is equal to one gray absorbed per minute.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0010061">
        <obo:IAO_0000115>A derived absorbed dose unit which is equal to one centigray absorbed per minute.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>cGy/min</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A derived absorbed dose unit which is equal to one centigray absorbed per minute.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>centigray per minute</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0010061"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A derived absorbed dose unit which is equal to one centigray absorbed per minute.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0010062">
        <obo:IAO_0000115>A derived absorbed dose unit which is equal to one milligray absorbed per minute.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>mGy/day</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A derived absorbed dose unit which is equal to one milligray absorbed per minute.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>milligray per minute</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0010062"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A derived absorbed dose unit which is equal to one milligray absorbed per minute.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0010063">
        <obo:IAO_0000115>A derived absorbed dose unit which is equal to one milligray absorbed per day.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>mGy/min</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A derived absorbed dose unit which is equal to one milligray absorbed per day.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>milligray per day</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0010063"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A derived absorbed dose unit which is equal to one milligray absorbed per day.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0010064">
        <obo:IAO_0000115>A derived absorbed dose unit which is equal to one milligray absorbed per hour.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>mGy/h</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A derived absorbed dose unit which is equal to one milligray absorbed per hour.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>milligray per hour</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0010064"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A derived absorbed dose unit which is equal to one milligray absorbed per hour.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0010065">
        <obo:IAO_0000115>A derived absorbed dose unit which is equal to one milligray absorbed per second.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>mGy/s</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A derived absorbed dose unit which is equal to one milligray absorbed per second.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>milligray per second</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0010065"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A derived absorbed dose unit which is equal to one milligray absorbed per second.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0010066">
        <obo:IAO_0000115>A length unit which is equal to one thousand meters.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>kilometre</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>km</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A length unit which is equal to one thousand meters.&quot; [UOB:LKSR]</rdfs:comment>
        <rdfs:label>kilometer</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0010066"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A length unit which is equal to one thousand meters.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>UOB:LKSR</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0010067">
        <obo:IAO_0000115>A mass unit density which is equal to mass of an object in milligrams divided by the volume in deciliters.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>mg/dl</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>milligram per decilitre</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A mass unit density which is equal to mass of an object in milligrams divided by the volume in deciliters.&quot; [UOB:LKSR]</rdfs:comment>
        <rdfs:label>milligram per deciliter</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0010067"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A mass unit density which is equal to mass of an object in milligrams divided by the volume in deciliters.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>UOB:LKSR</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0010068">
        <obo:IAO_0000115>A mass unit density which is equal to mass of an object in micrograms divided by the volume in deciliters.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>microgram per decilitre</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ug/dl</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A mass unit density which is equal to mass of an object in micrograms divided by the volume in deciliters.&quot; [UOB:LKSR]</rdfs:comment>
        <rdfs:label>microgram per deciliter</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0010068"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
