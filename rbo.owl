        <oboInOwl:hasDbXref>XAO:0000467</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0001370</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>pancreas dorsal primordium duct bud</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pancreas primordium dorsal bud</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>primary pancreatic bud</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>dorsal pancreas anlage</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>dorsal pancreatic anlage</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>posterior pancreatic anlage</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>posterior pancreatic bud</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0003923</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>
