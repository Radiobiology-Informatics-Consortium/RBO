    <!-- http://purl.obolibrary.org/obo/ENVO_00002874 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00002874">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00003074"/>
        <obo:IAO_0000115 xml:lang="en">A manufactuered product which is capable of removing heat and controlling the humidity of the air within a site.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym xml:lang="en">A/C</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">A/C unit</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">air conditioner</oboInOwl:hasBroadSynonym>
        <rdfs:label>air conditioning unit</rdfs:label>
