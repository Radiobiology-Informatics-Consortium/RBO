    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000140">
        <obo:IAO_0000115>A dose equivalent unit which when multiplied by hundred is equal to one sievert or 1 Sv. 1 Sv is equal to 100 rem.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>rem</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A dose equivalent unit which when multiplied by hundred is equal to one sievert or 1 Sv. 1 Sv is equal to 100 rem.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>Roentgen equivalent man</rdfs:label>
