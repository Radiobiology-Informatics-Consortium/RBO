        <owl:annotatedTarget>A mass unit density which is equal to mass of an object in grams divided by the volume in cubic centimeters.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>UOC:GVG</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000085">
        <obo:IAO_0000115>A luminance unit which is equal to a luminous intensity of one candela radiating from a surface whose area is one square meter.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>candela per square metre</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cd/m^[2]</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A luminance unit which is equal to a luminous intensity of one candela radiating from a surface whose area is one square meter.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>candela per square meter</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000085"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A luminance unit which is equal to a luminous intensity of one candela radiating from a surface whose area is one square meter.</owl:annotatedTarget>
