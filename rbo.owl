    <!-- http://purl.obolibrary.org/obo/ENVO_01001860 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001860">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000793"/>
        <obo:IAO_0000115>An atmospheric wind which 1) has an increased rate relative to other winds in the same region and 2) is followed by a lull.</obo:IAO_0000115>
        <dce:creator rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-19T21:47:51Z</dce:date>
        <oboInOwl:hasBroadSynonym>gust</oboInOwl:hasBroadSynonym>
        <rdfs:comment>According to U.S. weather observing practice, gusts are reported when the peak wind speed reaches at least 16 knots and the variation in wind speed between the peaks and lulls is at least 9 knots. The duration of a gust is usually less than 20 seconds.</rdfs:comment>
        <rdfs:label xml:lang="en">wind gust</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001860"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An atmospheric wind which 1) has an increased rate relative to other winds in the same region and 2) is followed by a lull.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="http://glossary.ametsoc.org/wiki/Gust"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Wind_gust"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001860"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>According to U.S. weather observing practice, gusts are reported when the peak wind speed reaches at least 16 knots and the variation in wind speed between the peaks and lulls is at least 9 knots. The duration of a gust is usually less than 20 seconds.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="http://glossary.ametsoc.org/wiki/Gust"/>
    </owl:Axiom>
    


