        <oboInOwl:hasDbXref>VHOG:0001095</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>4th pharyngeal arch ectoderm</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>UBERON:0005662</oboInOwl:id>
