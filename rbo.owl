    <!-- http://purl.obolibrary.org/obo/UBERON_0005602 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005602">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003281"/>
        <rdfs:subClassOf rdf:nodeID="genid50397"/>
        <rdfs:subClassOf rdf:nodeID="genid50399"/>
        <obo:IAO_0000115>The portion of mesentery attached to the greater curvature of the stomach is named the dorsal mesentery (or dorsal mesogastrium, when referring to the portion at the stomach), and the part which suspends the colon is termed the mesocolon. The dorsal mesogastrium develops into the greater omentum.</obo:IAO_0000115>
        <obo:UBPROP_0000001>The dorsal sheet of the primitive mesentery that encloses the stomach. The greater omentum develops from the dorsal mesogastrium. [TFD][VHOG]</obo:UBPROP_0000001>
        <oboInOwl:hasDbXref rdf:resource="http://en.wikipedia.org/wiki/Dorsal_mesentery"/>
        <oboInOwl:hasDbXref rdf:resource="http://linkedlifedata.com/resource/umls/id/C1512038"/>
        <oboInOwl:hasDbXref>EHDAA2:0000416</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EHDAA:3001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:17025</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0001618</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C34142</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1512038</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000352</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>dorsal mesentery</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0005602</oboInOwl:id>
        <rdfs:label>dorsal mesogastrium</rdfs:label>
    </owl:Class>
