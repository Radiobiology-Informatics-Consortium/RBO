        <oboInOwl:hasDbXref>MESH:D010183</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0001372</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000254</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0001372</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>duct of pancreas</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pancreas duct</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
