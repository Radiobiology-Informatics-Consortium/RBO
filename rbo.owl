    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0035282">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0003002"/>
        <obo:IAO_0000115>The regionalization process that divides an organism or part of an organism into a series of semi-repetitive parts, or segments, often arranged along a longitudinal axis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Wikipedia:Segmentation_(biology)</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0035282</oboInOwl:id>
        <rdfs:label>segmentation</rdfs:label>
    </owl:Class>
