        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0009007"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A plant structure (PO:0009011) that consists predominantly of similarly specialized plant cells (PO:0009002) of one or more types.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>POC:curators</oboInOwl:hasDbXref>
