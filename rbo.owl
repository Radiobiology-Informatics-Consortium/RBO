            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An environmental material which is composed primarily of particles.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Do not oversimplify this branch with design patterns or similar. The materials have properties that their components do not - write full definitions including these where possible.</obo:IAO_0000116>
        <oboInOwl:hasBroadSynonym xml:lang="en">particulate matter</oboInOwl:hasBroadSynonym>
        <oboInOwl:inSubset>envoAtmo</oboInOwl:inSubset>
