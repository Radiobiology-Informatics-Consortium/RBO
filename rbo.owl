    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000072">
        <obo:IAO_0000115>A molality unit which is equal to 10^[-12] m.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>pm</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A molality unit which is equal to 10^[-12] m.&quot; [UOC:GVG]</rdfs:comment>
