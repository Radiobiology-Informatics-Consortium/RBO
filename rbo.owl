        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Portion of tissue that gives rise to the lens.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://sourceforge.net/tracker/?func=detail&amp;atid=994726&amp;aid=3514998&amp;group_id=76834"/>
