        <owl:annotatedTarget>A dose equivalent unit which is equal to one thousandth of a millionth of a sievert or 10^[-9] Sv.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000145">
        <obo:IAO_0000115>An activity (of a radionuclide) unit which is equal to one thousandth of a curie or 10^[-3] Ci.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>mCi</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;An activity (of a radionuclide) unit which is equal to one thousandth of a curie or 10^[-3] Ci.&quot; [ORCBS:ORCBS]</rdfs:comment>
        <rdfs:label>millicurie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000145"/>
