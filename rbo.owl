    <owl:DatatypeProperty rdf:about="http://purl.obolibrary.org/obo/RBO_00010021">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/RBO_00005001"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    </owl:DatatypeProperty>
    


