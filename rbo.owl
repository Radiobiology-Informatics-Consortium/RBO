        <oboInOwl:hasDbXref>FMA:45616</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0001526</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C34180</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TGMA:0001014</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0231051</oboInOwl:hasDbXref>
