        <oboInOwl:hasExactSynonym>pectinate line of anal canal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>Hilton&apos;s &apos;white line&apos;</oboInOwl:hasRelatedSynonym>
