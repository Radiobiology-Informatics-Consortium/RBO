        </rdfs:subClassOf>
        <obo:IAO_0000115>Organic material which is primarily composed of plant structures, living or dead.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">plant matter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001122 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001122">
