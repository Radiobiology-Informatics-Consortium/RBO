        <obo:IAO_0000115>Directly binding to a specific protein and delivering it to a specific cellular location.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/geneontology/go-ontology/issues/17073</obo:IAO_0000233>
        <oboInOwl:created_by>pg</oboInOwl:created_by>
        <oboInOwl:creation_date>2019-04-01T10:41:38Z</oboInOwl:creation_date>
