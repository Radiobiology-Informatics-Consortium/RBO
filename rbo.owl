    <!-- http://purl.obolibrary.org/obo/UBERON_0001246 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001246">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003704"/>
