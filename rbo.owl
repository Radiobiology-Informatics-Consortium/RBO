        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001836"/>
        <obo:IAO_0000115>A montane shrubland biome is a shrubland biome which occurs in regions elevated above sea level and which has community structure determined by elevation-dependent environmental conditions.</obo:IAO_0000115>
        <oboInOwl:created_by>ORCID:0000-0002-4366-3088</oboInOwl:created_by>
