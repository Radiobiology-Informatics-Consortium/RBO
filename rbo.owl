    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000220">
        <obo:IAO_0000115>An electrical charge unit which is equal to the amount of charge transferred by a current of 1 ampere in 1 second.</obo:IAO_0000115>
