        <oboInOwl:hasDbXref>UMLS:C1516037</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0004121</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0001702</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>apical epidermal ridge</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>AER</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>crista ectodermalis apicalis</oboInOwl:hasRelatedSynonym>
