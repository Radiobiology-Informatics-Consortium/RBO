    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000086">
        <obo:IAO_0000115>An area density unit which is equal to the mass of an object in kilograms divided by the surface area in meters squared.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>kg/m^[2]</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>kilogram per square metre</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;An area density unit which is equal to the mass of an object in kilograms divided by the surface area in meters squared.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>kilogram per square meter</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000086"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An area density unit which is equal to the mass of an object in kilograms divided by the surface area in meters squared.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000087">
        <obo:IAO_0000115>A molar mass unit which is equal to one kilogram of mass of one mole of chemical element or chemical compound.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>kg/mol</oboInOwl:hasExactSynonym>
