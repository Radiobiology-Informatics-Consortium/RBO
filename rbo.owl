        <oboInOwl:id>GO:0072001</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#gocheck_do_not_annotate"/>
        <rdfs:label>renal system development</rdfs:label>
    </owl:Class>
