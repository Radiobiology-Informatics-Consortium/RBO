        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>UBERON:0005622</oboInOwl:id>
        <rdfs:label>right dorsal aorta</rdfs:label>
    </owl:Class>
