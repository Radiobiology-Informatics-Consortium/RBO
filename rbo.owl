    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000234">
        <obo:IAO_0000115>An information unit which is equal to 1000 bytes.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>kB</oboInOwl:hasExactSynonym>
