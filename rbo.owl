        <oboInOwl:hasDbXref>UOC:GVG</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000070">
        <obo:IAO_0000115>A molality unit which is equal to one millionth of a molal or 10^[-6] m.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>um</oboInOwl:hasExactSynonym>
