    <!-- http://purl.obolibrary.org/obo/UBERON_0000211 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000211">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000062"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002384"/>
