    <!-- http://purl.obolibrary.org/obo/OBI_0002210 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0002210">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <obo:IAO_0000111>histologic grade according to the Fuhrman Nuclear Grading System</obo:IAO_0000111>
