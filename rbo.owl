    <!-- http://purl.obolibrary.org/obo/GO_0005635 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0005635">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0031967"/>
