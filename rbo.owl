        <oboInOwl:id>UBERON:0003687</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#vertebrate_core"/>
        <rdfs:comment>Design pattern notes: check whether this fits the foramen design pattern</rdfs:comment>
        <rdfs:label>foramen magnum</rdfs:label>
        <foaf:depicted_by rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/3/39/Gray130.png</foaf:depicted_by>
