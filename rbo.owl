        <oboInOwl:hasDbXref>VHOG:0000511</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0001272</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>dorsal visceral arch 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>upper pharyngeal jaw</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>dorsal mandibular arch</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>dorsal pharyngeal arch 1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>dorsal visceral arch 1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>palatoquadrate arch</oboInOwl:hasRelatedSynonym>
