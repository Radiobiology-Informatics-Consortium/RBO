        <obo:IAO_0000115>The red vascular substance consisting of connective tissue and blood vessels, containing primitive blood cells, macrophages, megakaryocytes, and fat cells. Red marrow is found in the cavities of many bones. It manufactures and releases leukocytes and erythrocytes into the bloodstream.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.snomedbrowser.com/Codes/Details/328538003"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.snomedbrowser.com/Codes/Details/75330005"/>
        <oboInOwl:hasDbXref>BTO:0001160</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:74595</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>medulla ossium rubra</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>parenchymal red marrow</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>red marrow</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>parenchyma of none marrow marrow</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0000361</oboInOwl:id>
        <rdfs:label>red bone marrow</rdfs:label>
    </owl:Class>
