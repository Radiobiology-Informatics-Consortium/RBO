    <!-- http://purl.obolibrary.org/obo/UBERON_0000995 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000995">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CARO_0000000"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0013515"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
