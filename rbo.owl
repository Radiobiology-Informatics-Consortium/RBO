    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0045214 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0045214">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GO_0016043"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002592"/>
