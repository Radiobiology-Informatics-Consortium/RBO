    <!-- http://purl.obolibrary.org/obo/ENVO_01000420 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000420">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
