        <oboInOwl:hasDbXref rdf:resource="http://sourceforge.net/tracker/?func=detail&amp;aid=3091300&amp;group_id=76834&amp;atid=1205376"/>
        <oboInOwl:hasDbXref>ISBN:0073040584</oboInOwl:hasDbXref>
