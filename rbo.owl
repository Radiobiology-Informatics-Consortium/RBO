            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any process that results in a change in state or activity of a cell or an organism (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of a catecholamine stimulus. A catecholamine is any of a group of biogenic amines that includes 4-(2-aminoethyl)pyrocatechol [4-(2-aminoethyl)benzene-1,2-diol] and derivatives formed by substitution.</obo:IAO_0000115>
        <oboInOwl:created_by>mah</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-09-13T02:51:13Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>response to catecholamine stimulus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0071869</oboInOwl:id>
        <rdfs:label>response to catecholamine</rdfs:label>
    </owl:Class>
