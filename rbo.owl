        <oboInOwl:hasDbXref>FMA:7144</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:21</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D008643</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C33103</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0025474</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:Mesentery</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>generic mesentery</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mesentery (generic)</oboInOwl:hasExactSynonym>
