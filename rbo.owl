    <!-- http://purl.obolibrary.org/obo/UBERON_0002546 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002546">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005085"/>
