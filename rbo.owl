        <oboInOwl:hasDbXref>FMA:5883</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:800</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D013153</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>splanchnic nerves</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>visceral nerve</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0003715</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
