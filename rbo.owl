    <!-- http://purl.obolibrary.org/obo/PATO_0001481 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001481">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000052"/>
        <obo:IAO_0000115>A shape quality inhering in a bearer by virtue of the bearer&apos;s having an oblique or slanted direction.</obo:IAO_0000115>
        <rdfs:label>sloped</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001485 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001485">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000141"/>
        <obo:IAO_0000115>A structural quality inhering in a bearer by virtue of the bearer&apos;s being thicker or more closely packed together; pressed tightly together.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>compact</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym>compressed</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>squashed</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>dense</oboInOwl:hasRelatedSynonym>
        <rdfs:label>condensed</rdfs:label>
    </owl:Class>
    


