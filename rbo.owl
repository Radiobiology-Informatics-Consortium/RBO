        <owl:annotatedTarget>LTER:809</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://vocab.lternet.edu/vocab/vocab/index.php?tema=809&amp;/biomes</oboInOwl:hasDbXref>
    </owl:Axiom>
