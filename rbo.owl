    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00002121">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00002119"/>
        <obo:IAO_0000115>Unplanned irradiation that is non-anthropogenic in origin</obo:IAO_0000115>
        <rdfs:label>unplanned naturally occurring radiation exposure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00002122 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00002122">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_02500041"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002234"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/RBO_010016"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Environmental monitoring that includes continual assay for radiation dose or quality.</obo:IAO_0000115>
        <rdfs:label>environmental radiation monitoring</rdfs:label>
