        <oboInOwl:hasDbXref>FMA:53672</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000317</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0001580</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0003170</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0001580</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>brain box</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>brain case</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>brain pan</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>braincase</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001703</oboInOwl:id>
