        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process in which a relatively unspecialized cell acquires specialized features of a myoblast. A myoblast is a mononucleate cell type that, by fusion with other myoblasts, gives rise to the myotubes that eventually develop into striated muscle fibers.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>CL:0000056</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:go_curators</oboInOwl:hasDbXref>
