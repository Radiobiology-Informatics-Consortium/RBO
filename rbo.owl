    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000071">
        <obo:IAO_0000115>A molality unit which is equal to one thousandth of one millionth of a molal or 10^[-9] m.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>nm</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A molality unit which is equal to one thousandth of one millionth of a molal or 10^[-9] m.&quot; [UOC:GVG]</rdfs:comment>
