        <oboInOwl:hasDbXref>EHDAA2:0000001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EHDAA2:0003235</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:36040</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C34131</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1516779</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>embryo plus adnexa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>UBERON:0004716</oboInOwl:id>
        <rdfs:label>conceptus</rdfs:label>
    </owl:Class>
