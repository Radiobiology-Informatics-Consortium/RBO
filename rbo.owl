    <!-- http://purl.obolibrary.org/obo/ENVO_01001574 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/ENVO_01001574">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001570"/>
