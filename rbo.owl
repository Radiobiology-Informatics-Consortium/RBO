    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000075">
        <obo:IAO_0000115>A unit of concentration which is one gram equivalent of a solute per liter of solution. A gram equivalent weight or equivalent is a measure of the reactive capacity of a given molecule.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>N</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A unit of concentration which is one gram equivalent of a solute per liter of solution. A gram equivalent weight or equivalent is a measure of the reactive capacity of a given molecule.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>normal</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000075"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A unit of concentration which is one gram equivalent of a solute per liter of solution. A gram equivalent weight or equivalent is a measure of the reactive capacity of a given molecule.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Wikipedia</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000076">
        <obo:IAO_0000115>A concentration unit which denotes the number of moles of solute as a proportion of the total number of moles in a solution.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>(x)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>chi</oboInOwl:hasExactSynonym>
