        <obo:IAO_0000117>James Malone</obo:IAO_0000117>
        <efo:definition_citation>http://jaxmice.jax.org/strain/001026.html</efo:definition_citation>
        <rdfs:label>BALB/cByJ</rdfs:label>
    </owl:Class>
    


