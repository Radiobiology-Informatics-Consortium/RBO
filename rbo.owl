        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000203"/>
        <obo:IAO_0000115>An environmental condition in which annual precipitation is less than half of annual potential evapotranspiration.</obo:IAO_0000115>
        <oboInOwl:created_by>ORCID:0000-0002-4366-3088</oboInOwl:created_by>
        <oboInOwl:creation_date>2013-04-24T13:28:18Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>EcoLexicon:aridity</oboInOwl:hasDbXref>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:label>arid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000238 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000238">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000203"/>
        <obo:IAO_0000115>A polar condition is an environmental condition in which an environmental system receives low, yearly solar irradiance per unit area, resulting in colder climatic conditions.</obo:IAO_0000115>
        <oboInOwl:created_by>ORCID:0000-0002-4366-3088</oboInOwl:created_by>
        <oboInOwl:creation_date>2013-05-08T07:49:36Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>SPIRE:Polar</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SWEETRealm:Polarization</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>frigid</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:comment>On Earth, polar conditions are such that every month has average temperature lower than 10 degrees Celsius. Note that  this class refers to a climatic rather than a positional condition.</rdfs:comment>
        <rdfs:label>polar</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000238"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A polar condition is an environmental condition in which an environmental system receives low, yearly solar irradiance per unit area, resulting in colder climatic conditions.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Polar_climate</oboInOwl:hasDbXref>
    </owl:Axiom>
