                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000635"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A material transport process during which a geological surface shifts downward relative to a datum such as sea-level.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>subsidence</oboInOwl:hasBroadSynonym>
        <oboInOwl:inSubset>environmental_hazards</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">geological subsidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000694"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A material transport process during which a geological surface shifts downward relative to a datum such as sea-level.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Subsidence</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000703 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000703">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000875"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002233"/>
                <owl:someValuesFrom>
                    <owl:Class>
