        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A momentum unit which is equal to the momentum of a one kilogram mass object with a speed of one meter per second.</owl:annotatedTarget>
