        <obo:IAO_0000115>Any process that results in a change in state or activity of a cell or an organism (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of a glucose stimulus.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>response to glucose stimulus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0009749</oboInOwl:id>
        <rdfs:label>response to glucose</rdfs:label>
    </owl:Class>
