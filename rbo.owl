    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000091">
        <obo:IAO_0000115>A momentum unit which is equal to the momentum of a one kilogram mass object with a speed of one meter per second.</obo:IAO_0000115>
