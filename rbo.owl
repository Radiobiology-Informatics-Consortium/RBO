        <obo:IAO_0000115>A position which is relatively high.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>high position</oboInOwl:hasRelatedSynonym>
        <rdfs:label>increased position</rdfs:label>
    </owl:Class>
    


