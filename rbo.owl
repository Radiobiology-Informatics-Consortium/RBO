        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0048513</oboInOwl:id>
        <rdfs:label>animal organ development</rdfs:label>
    </owl:Class>
