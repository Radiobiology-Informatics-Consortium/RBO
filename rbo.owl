        <obo:IAO_0000115>Mixed radiation consisting of one or more species of ion and one or more species of gamma-ray photons</obo:IAO_0000115>
        <rdfs:label>mixed ion and gamma radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005062 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005062">
