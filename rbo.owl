        <rdfs:label>buccopharyngeal membrane</rdfs:label>
        <foaf:depicted_by rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/9/93/Gray977.png</foaf:depicted_by>
    </owl:Class>
