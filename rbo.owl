        <rdfs:label>dorsum</rdfs:label>
        <foaf:depicted_by rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/e/ee/432px-Gray-back.PNG</foaf:depicted_by>
