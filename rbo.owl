    <!-- http://purl.obolibrary.org/obo/GO_0000904 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0000904">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GO_0000902"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
