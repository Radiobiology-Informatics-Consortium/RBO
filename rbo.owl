        <oboInOwl:hasDbXref>MA:0001917</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>arteria labialis superior</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ramus labialis superior arteriae facialis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>superior labial artery</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>superior labial branch of facial artery</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
