    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001543">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001546"/>
        <obo:IAO_0000115>A physical quality inhering in a bearer by virtue of the bearer&apos;s disposition to being turned, bowed, or twisted without breaking.</obo:IAO_0000115>
        <rdfs:label>flexibility</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001545 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001545">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001543"/>
        <obo:IAO_0000115>A physical quality inhering in a bearer by virtue of the bearer&apos;s inability of being turned, bowed, or twisted without breaking.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>stiff</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>stiffness</oboInOwl:hasRelatedSynonym>
        <rdfs:label>inflexible</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001546 -->

