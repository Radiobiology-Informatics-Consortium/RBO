        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">A class prediction data transformation (sometimes called supervised classification) is a data transformation that has objective class prediction.</obo:IAO_0000115>
        <obo:IAO_0000117>James Malone</obo:IAO_0000117>
        <obo:IAO_0000118>supervised classification data transformation</obo:IAO_0000118>
