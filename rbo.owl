        <oboInOwl:hasOBONamespace>external</oboInOwl:hasOBONamespace>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>capable_of_part_of</oboInOwl:id>
        <oboInOwl:shorthand>capable_of_part_of</oboInOwl:shorthand>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ro.owl"/>
