                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00002006"/>
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000277"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001008"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002473"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00002006"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000277"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A meteor which is primarily composed of water.</obo:IAO_0000115>
        <oboInOwl:inSubset>envoAtmo</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">hydrometeor</rdfs:label>
    </owl:Class>
