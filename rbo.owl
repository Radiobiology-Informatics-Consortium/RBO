            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>That part of a multicellular organism outside the cells proper, usually taken to be outside the plasma membranes, and occupied by fluid.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>NIF_Subcellular:sao1425028079</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>cellular_component</oboInOwl:hasOBONamespace>
