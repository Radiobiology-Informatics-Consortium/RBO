    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000195">
        <obo:IAO_0000111>degree Fahrenheit</obo:IAO_0000111>
        <obo:IAO_0000115>A temperature unit which is equal to 5/9ths of a kelvin. Negative 40 degrees Fahrenheit is equal to negative 40 degrees Celsius.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <oboInOwl:hasExactSynonym>F</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A temperature unit which is equal to 5/9ths of a kelvin. Negative 40 degrees Fahrenheit is equal to negative 40 degrees Celsius.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>degree Fahrenheit</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000195"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
