    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000108">
        <obo:IAO_0000115>A force unit which is equal to the force required to cause an acceleration of 1m/s2 of a mass of 1 Kg in the direction of the force.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>N</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A force unit which is equal to the force required to cause an acceleration of 1m/s2 of a mass of 1 Kg in the direction of the force.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>newton</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000108"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A force unit which is equal to the force required to cause an acceleration of 1m/s2 of a mass of 1 Kg in the direction of the force.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000110">
        <obo:IAO_0000115>A pressure unit which is equal to the pressure or stress on a surface caused by a force of 1 newton spread over a surface of 1 m^[2].</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Pa</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A pressure unit which is equal to the pressure or stress on a surface caused by a force of 1 newton spread over a surface of 1 m^[2].&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>pascal</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000110"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A pressure unit which is equal to the pressure or stress on a surface caused by a force of 1 newton spread over a surface of 1 m^[2].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000112">
        <obo:IAO_0000115>An energy unit which is equal to the energy required when a force of 1 newton moves an object 1 meter in the direction of the force.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>J</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;An energy unit which is equal to the energy required when a force of 1 newton moves an object 1 meter in the direction of the force.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>joule</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000112"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An energy unit which is equal to the energy required when a force of 1 newton moves an object 1 meter in the direction of the force.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000114">
        <obo:IAO_0000115>A power unit which is equal to the power used when work is done at the rate of 1 joule per second.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>W</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A power unit which is equal to the power used when work is done at the rate of 1 joule per second.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>watt</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000114"/>
