        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000138">
        <obo:IAO_0000115>A dose equivalent unit which is equal to one thousandth of a sievert or 10^[-3] Sv.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>mSv</oboInOwl:hasExactSynonym>
