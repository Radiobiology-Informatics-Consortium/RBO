        <rdfs:label>kilogram per mole</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000087"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A molar mass unit which is equal to one kilogram of mass of one mole of chemical element or chemical compound.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000088">
        <obo:IAO_0000115>A molar mass unit which is equal to one gram of mass of one mole of chemical element or chemical compound.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>g/mol</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A molar mass unit which is equal to one gram of mass of one mole of chemical element or chemical compound.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>gram per mole</rdfs:label>
