    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000069">
        <obo:IAO_0000115>A molality unit which is equal to one thousandth of a molal or 10^[-3] m.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>mm</oboInOwl:hasExactSynonym>
