    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000139">
        <obo:IAO_0000115>A dose equivalent unit which is equal to one millionth of a sievert or 10^[-6] Sv.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>uSv</oboInOwl:hasExactSynonym>
