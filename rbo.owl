        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An environmental system which is determined by materials bearing roughly homogeneous qualities.</obo:IAO_0000115>
        <rdfs:comment>Organisational class. Not intended for annotation.</rdfs:comment>
        <rdfs:label xml:lang="en">environmental system determined by a quality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000998 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000998">
