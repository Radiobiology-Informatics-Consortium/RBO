        <oboInOwl:hasDbXref>FMA:3939</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:479</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0001926</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D017536</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C32352</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0162859</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000272</oboInOwl:hasDbXref>
