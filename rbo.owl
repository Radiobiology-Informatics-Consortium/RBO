    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000232">
        <obo:IAO_0000115>An information unit which refers to a digit in the binary numeral system, which consists of base 2 digits (ie there are only 2 possible values: 0 or 1).</obo:IAO_0000115>
        <rdfs:comment>&quot;An information unit which refers to a digit in the binary numeral system, which consists of base 2 digits (ie there are only 2 possible values: 0 or 1).&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>bit</rdfs:label>
