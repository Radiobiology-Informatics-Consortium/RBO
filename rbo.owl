        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005744"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Anatomical space that is an opening in a bone, usually for passage of blood vessels or nerves.</owl:annotatedTarget>
