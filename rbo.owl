    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005063">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000015"/>
        <obo:IAO_0000115>Mixed radiation consisting of one or more species of ion and neutron radiation</obo:IAO_0000115>
        <rdfs:label>mixed ion and neutron radiation</rdfs:label>
    </owl:Class>
    


