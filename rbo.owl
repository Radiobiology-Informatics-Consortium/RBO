        <oboInOwl:hasRelatedSynonym>gastroenterological system</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>gastrointestinal (GI) tract</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>gastrointestinal system</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>gastrointestinal tract</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0005409</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>alimentary part of gastrointestinal system</rdfs:label>
    </owl:Class>
