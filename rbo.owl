    <!-- http://purl.obolibrary.org/obo/UBERON_0005409 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005409">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000467"/>
        <rdfs:subClassOf>
