        <oboInOwl:hasOBONamespace>protein</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>single organism process</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>single-organism process</oboInOwl:hasRelatedSynonym>
