        <owl:annotatedTarget>A power unit which is equal to the power used when work is done at the rate of 1 joule per second.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000116">
        <obo:IAO_0000115>An illuminance unit which is equal to the illuminance produced by 1 lumen evenly spread over an area 1 m^[2].</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>lx</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;An illuminance unit which is equal to the illuminance produced by 1 lumen evenly spread over an area 1 m^[2].&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>lux</rdfs:label>
