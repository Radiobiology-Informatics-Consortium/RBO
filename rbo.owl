        <owl:annotatedTarget>An information unit which is equal to 1000 bytes.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Wikipedia</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000235">
