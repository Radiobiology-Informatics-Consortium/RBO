        <obo:IAO_0000115>Desublimation is a process in which a portion of some gas undergoes a phase transition into a portion of some solid.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>deposition</oboInOwl:hasBroadSynonym>
        <rdfs:label xml:lang="en">desublimation process</rdfs:label>
    </owl:Class>
    <owl:Axiom>
