        <owl:annotatedTarget>An activity (of a radionuclide) unit which is equal to one thousandth of a curie or 10^[-3] Ci.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ORCBS:ORCBS</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000146">
        <obo:IAO_0000115>An activity (of a radionuclide) unit which is equal to one millionth of a curie or 10^[-6] Ci.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>uCi</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;An activity (of a radionuclide) unit which is equal to one millionth of a curie or 10^[-6] Ci.&quot; [ORCBS:ORCBS]</rdfs:comment>
        <rdfs:label>microcurie</rdfs:label>
