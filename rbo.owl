        <oboInOwl:hasExactSynonym>B</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;An information unit which is equal to 8 bits.&quot; [Wikipedia:Wikipedia]</rdfs:comment>
        <rdfs:label>byte</rdfs:label>
