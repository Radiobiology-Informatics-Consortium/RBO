        <obo:IAO_0000117>0000-0002-5111-7263</obo:IAO_0000117>
        <rdfs:label>meteorology study</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00002111 -->

