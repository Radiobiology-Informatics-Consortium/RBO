    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RBO_00010021">
        <obo:IAO_0000115>Radon dosimeters are radiation dosimeters used to measure the presence and concentration of radon gas (Rn-222), a radioactive noble gas that can accumulate in buildings and pose health risks. Different types of radon detectors use various detection methods, based on the radioactive decay products of radon.</obo:IAO_0000115>
        <obo:IAO_0000115>The atomic mass (ma or m) is the mass of an atom.  The protons and neutrons of the nucleus account for nearly all of the total mass of atoms, with the electrons and nuclear binding energy making minor contributions.  It is measured in Daltons (unit).</obo:IAO_0000115>
        <obo:IAO_0000118>radon detector</obo:IAO_0000118>
        <rdfs:label>mass number</rdfs:label>
        <rdfs:label>radon dosimeter</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000008">
        <obo:IAO_0000111>meter</obo:IAO_0000111>
        <obo:IAO_0000115>A length unit which is equal to the length of the path traveled by light in vacuum during a time interval of 1/299 792 458 of a second.</obo:IAO_0000115>
        <obo:IAO_0000118>m</obo:IAO_0000118>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <oboInOwl:hasExactSynonym>m</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>metre</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A length unit which is equal to the length of the path traveled by light in vacuum during a time interval of 1/299 792 458 of a second.&quot; [BIPM:BIPM, NIST:NIST]</rdfs:comment>
        <rdfs:label>meter</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000008"/>
