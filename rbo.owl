                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006909"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any material entity that is located in the digestive tract. This includes undigested food and liquid as well as unexcreted waste products. It also includes other entities such as ingested stones used to aid digestion. Any microbial cells or cell populations are also included.</obo:IAO_0000115>
        <obo:IAO_0000116>Note that we treat any material entity that is ingested as an anatomical structure by defintion, although this may be expanding the CARO usage somewhat</obo:IAO_0000116>
        <oboInOwl:hasExactSynonym>digestive tract contents</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>ingested material entity</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0035118</oboInOwl:id>
        <rdfs:label>material entity in digestive tract</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0035118"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any material entity that is located in the digestive tract. This includes undigested food and liquid as well as unexcreted waste products. It also includes other entities such as ingested stones used to aid digestion. Any microbial cells or cell populations are also included.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://github.com/EnvironmentOntology/envo/issues/110"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0035118"/>
