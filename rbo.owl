        <oboInOwl:hasDbXref>GAID:235</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000311</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D002574</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C12693</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0003076</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:CervicalVertebra</oboInOwl:hasDbXref>
