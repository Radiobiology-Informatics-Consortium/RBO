        <oboInOwl:hasExactSynonym>midbrain-hindbrain orgainizer development</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0030917</oboInOwl:id>
        <rdfs:label>midbrain-hindbrain boundary development</rdfs:label>
    </owl:Class>
