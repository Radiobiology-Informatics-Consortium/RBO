        <rdfs:label>right lobe of liver</rdfs:label>
        <foaf:depicted_by rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/a/a3/Gray1087-liver.png</foaf:depicted_by>
    </owl:Class>
