        <obo:IAO_0000115>An atomic nucleus with 26 protons and 30 neutrons </obo:IAO_0000115>
        <obo:IAO_0000118>Fe-56 ion;Fe-56 nucleus;Fe-56 </obo:IAO_0000118>
        <rdfs:label>Iron-56 nucleus</rdfs:label>
    </owl:Class>
    


