        <oboInOwl:hasDbXref>ZFA:0001024</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>TNC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>trunk crest</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0003083</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:label>trunk neural crest</rdfs:label>
    </owl:Class>
