        <obo:IAO_0000116>This class will be axiomatised with &quot;alga&quot; once an approach to handle this term&apos;s ambiguous semantics has been agreed with PCO.</obo:IAO_0000116>
        <rdfs:comment>An organic material which is primarily composed of living or dead algae, along with their exudates.</rdfs:comment>
        <rdfs:label xml:lang="en">algal material</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001189"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>An organic material which is primarily composed of living or dead algae, along with their exudates.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Algae</oboInOwl:hasDbXref>
    </owl:Axiom>
    


