            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Potential energy which is stored in the fields of propagated by electromagnetic radiation.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-03T20:29:21Z</oboInOwl:creation_date>
        <rdfs:label>radiant energy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_2000032 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_2000032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_2000017"/>
        <obo:IAO_0000115 xml:lang="en">Kinetic energy which is realised through the microscopic motion of particles.</obo:IAO_0000115>
        <dce:contributor rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <dce:creator rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-03T20:30:20Z</oboInOwl:creation_date>
        <rdfs:comment xml:lang="en">A form of disordered mechanical energy.</rdfs:comment>
        <rdfs:label>thermal energy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_2000034 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_2000034">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_2000032"/>
        <obo:IAO_0000115>Thermal energy which propagates through a solid (typically rocky) astronomical body.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-03T20:47:30Z</oboInOwl:creation_date>
        <rdfs:comment>Often, this term is used specifically for thermal energy spreading from heat sources (e.g. magma chambers, the planetary core) within the Earth. However, it is also used for extraterrestrial bodies.</rdfs:comment>
        <rdfs:label>geothermal energy</rdfs:label>
    </owl:Class>
    


