        <obo:IAO_0000115>Ectoderm destined to be nervous tissue.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>neurectoderm cell</oboInOwl:hasExactSynonym>
        <rdfs:label>neurectodermal cell</rdfs:label>
