    <!-- http://purl.obolibrary.org/obo/RO_0004047 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0004047">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002418"/>
