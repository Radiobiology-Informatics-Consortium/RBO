        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Cranial ectodermal placode with potential to develop into a component of the nervous system, such as nerves or ganglia.</owl:annotatedTarget>
