                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:unionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_64909"/>
                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_78298"/>
                                        </owl:unionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A portion of contaminated soil is a portion of soil with elevated levels of some contaminant.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>ENVO</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ENVO:00002116</oboInOwl:id>
        <rdfs:comment>&quot;contaminant&quot; is more of a disposition - any material entity can be a contaminant in particular circumstances.</rdfs:comment>
        <rdfs:label>contaminated soil</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_00002149 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00002149">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00002010"/>
