        <owl:annotatedTarget>An area unit which is equal to one millionth of a square meter or 10^[-6] m^[2].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000083">
        <obo:IAO_0000115>A mass unit density which is equal to mass of an object in kilograms divided by the volume in cubic meters.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>kg/m^[3]</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>kilogram per cubic metre</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A mass unit density which is equal to mass of an object in kilograms divided by the volume in cubic meters.&quot; [UOC:GVG]</rdfs:comment>
        <rdfs:label>kilogram per cubic meter</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000083"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A mass unit density which is equal to mass of an object in kilograms divided by the volume in cubic meters.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>UOC:GVG</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000084">
        <obo:IAO_0000115>A mass unit density which is equal to mass of an object in grams divided by the volume in cubic centimeters.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>g/cm^[3]</oboInOwl:hasExactSynonym>
