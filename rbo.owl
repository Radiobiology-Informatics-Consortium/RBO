    <!-- http://purl.obolibrary.org/obo/UBERON_0000970 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000970">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CARO_0000000"/>
