    <!-- http://purl.obolibrary.org/obo/UBERON_0005734 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005734">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004797"/>
