        <oboInOwl:ontology>FMA</oboInOwl:ontology>
        <oboInOwl:source>FMA:45626</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004581"/>
