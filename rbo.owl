        <rdfs:label xml:lang="en">Pilbara Shrublands Ecoregion</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001575 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/ENVO_01001575">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001570"/>
