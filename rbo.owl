    <!-- http://purl.obolibrary.org/obo/RO_0002428 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002428">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002263"/>
