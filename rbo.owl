    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005059 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005059">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000015"/>
        <obo:IAO_0000115>Mixed radiation consisting of ions of different species, e.g. protons and iron ions</obo:IAO_0000115>
        <obo:IAO_0000118>mixed ion radiation</obo:IAO_0000118>
        <rdfs:label>multiple ion radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005060 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005060">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000015"/>
        <obo:IAO_0000115>Mixed radiation consisting of one or more species of ion and one or more species of ionizing photons</obo:IAO_0000115>
        <obo:IAO_0000116>Photons used in investigations are most commonly ionizing photons, classified as either x-ray or gamma, depending upon the energy, but in some instances including high energy ultraviolet (UVC)</obo:IAO_0000116>
        <rdfs:label>mixed ion and photon radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005061 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005061">
