        <rdfs:label>ethmoid bone</rdfs:label>
        <foaf:depicted_by rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/6/66/Illu_cranial_bones2.jpg</foaf:depicted_by>
