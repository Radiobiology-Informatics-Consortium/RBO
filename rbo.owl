        <oboInOwl:hasRelatedSynonym>tail region</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0006076</oboInOwl:id>
        <rdfs:label>caudal region of vertebral column</rdfs:label>
