        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000116"/>
        <obo:IAO_0000115>Electromagnetic radiation having sufficient energy to remove one or more electrons from an atom</obo:IAO_0000115>
        <rdfs:label>ionizing electromagnetic radiation</rdfs:label>
    </owl:Class>
    


