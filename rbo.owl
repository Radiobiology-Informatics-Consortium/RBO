    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00002013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000082"/>
        <obo:IAO_0000115>Studies relating to human society and the interrelation of social and educational factors with individual thought and behaviour including mental illness.</obo:IAO_0000115>
        <obo:IAO_0000117>0000-0002-5111-7263</obo:IAO_0000117>
        <rdfs:label>social and psychosocial study</rdfs:label>
    </owl:Class>
    


