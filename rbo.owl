                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A desublimation process during which water vapour is frozen into water ice.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <obo:IAO_0000117>http://orcid.org/0000-0002-3410-4655</obo:IAO_0000117>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">desublimation of water vapour into ice</rdfs:label>
    </owl:Class>
    


