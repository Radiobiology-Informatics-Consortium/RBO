    <!-- http://purl.obolibrary.org/obo/ENVO_01001334 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001334">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_03000010"/>
