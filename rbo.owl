    <!-- http://purl.obolibrary.org/obo/UBERON_0010427 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010427">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000481"/>
