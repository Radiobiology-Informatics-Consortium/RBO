        <oboInOwl:hasDbXref>FMA:58617</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0001319</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C49328</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0459649</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000266</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>retina layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>retina neuronal layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>retinal layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>retinal neuronal layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>UBERON:0001781</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#vertebrate_core"/>
        <rdfs:label>layer of retina</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001781"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
