        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_27363"/>
        <obo:IAO_0000115>A zinc atom in which the nucleus contains 35 neutrons. It has a half-life of 244 days, decaying by emission of a positron (beta(+) decay), and is the most abundant and stable of the 25 known radioisotopes of zinc.</obo:IAO_0000115>
        <chebi:charge>0</chebi:charge>
        <chebi:formula>[65Zn]</chebi:formula>
        <chebi:inchi>InChI=1S/Zn/i1+0</chebi:inchi>
        <chebi:inchikey>HCHKCACWOHOZIP-IGMARMGPSA-N</chebi:inchikey>
        <chebi:mass>64.929</chebi:mass>
        <chebi:monoisotopicmass>64.92925</chebi:monoisotopicmass>
        <chebi:smiles>[65Zn]</chebi:smiles>
