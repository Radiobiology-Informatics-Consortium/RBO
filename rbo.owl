        <oboInOwl:hasDbXref>WBbt:0005409</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>motoneuron</oboInOwl:hasExactSynonym>
        <rdfs:label>motor neuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000100"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
