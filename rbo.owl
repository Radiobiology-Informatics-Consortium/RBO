        <oboInOwl:hasDbXref>UMLS:C0229232</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000550</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005574</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>capsula lentis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lens capsule</oboInOwl:hasExactSynonym>
