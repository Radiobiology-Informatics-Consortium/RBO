    <!-- http://purl.obolibrary.org/obo/UBERON_0000971 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000971">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000970"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002536"/>
