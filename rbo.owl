        <oboInOwl:hasExactSynonym>mGy</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;An absorbed dose unit which is equal to one thousandth of a gray or 10^[-3] Gy.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>milligray</rdfs:label>
