        <oboInOwl:hasExactSynonym>s^1</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A frequency unit which is equal to 1 complete cycle of a recurring phenomenon in 1 second.&quot; [NIST:NIST]</rdfs:comment>
        <rdfs:label>hertz</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000106"/>
