    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0012481">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0000483"/>
