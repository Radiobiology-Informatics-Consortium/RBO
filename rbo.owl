    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00002123">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_02500041"/>
        <obo:IAO_0000115>Monitoring within an environment which was not man-made.</obo:IAO_0000115>
        <rdfs:label>natural environment monitoring</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00002124 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00002124">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_02500041"/>
        <obo:IAO_0000115>Monitoring within a man-made or constructed environment</obo:IAO_0000115>
        <rdfs:label>anthropogenic environment monitoring</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00002125 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00002125">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00002122"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00002124"/>
        <obo:IAO_0000115>Monitoring for radiation dose or quality within a man-made or constructed environment such as a building or a vehicle.</obo:IAO_0000115>
