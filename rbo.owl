        <oboInOwl:hasDbXref>EMAPA:35493</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:21496</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:30319</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000113</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D008022</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C13046</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0001682</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0023685</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001272</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0004031</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0001675</oboInOwl:hasDbXref>
