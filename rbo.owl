        <obo:IAO_0000115 xml:lang="en">A shrubland biome which is subject to temperate climate patterns.</obo:IAO_0000115>
        <oboInOwl:created_by>ORCID:0000-0002-4366-3088</oboInOwl:created_by>
        <oboInOwl:creation_date>2013-04-07T14:40:32Z</oboInOwl:creation_date>
