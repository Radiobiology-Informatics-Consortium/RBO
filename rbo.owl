        <oboInOwl:hasDbXref>EMAPA:17839</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:70612</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0001302</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C33641</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>RETIRED_EHDAA2:0000976</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1182652</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001425</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>lens subcapsular epithelium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>subcapsular lens epithelium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>anterior epithelium of lens vesicle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>anterior surface of lens</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0005614</oboInOwl:id>
        <rdfs:label>lens anterior epithelium</rdfs:label>
    </owl:Class>
