        <oboInOwl:hasDbXref>PMID:17572649</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0001508 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0001508">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0042391"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:complementOf>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002162"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_4895"/>
                    </owl:Restriction>
                </owl:complementOf>
            </owl:Class>
        </rdfs:subClassOf>
