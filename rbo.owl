                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PCO_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An environmental system which can sustain and allow the growth of an ecological population.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EcoLexicon:habitat</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>LTER:238</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SWEETRealm:Habitat</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Habitat</oboInOwl:hasDbXref>
        <rdfs:comment>A habitat&apos;s specificity to an ecological population differentiates it from other environment classes.</rdfs:comment>
        <rdfs:label xml:lang="en">habitat</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000739"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
