        <oboInOwl:hasDbXref>CALOHA:TS-0737</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:63032</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>acinar cell of pancreas</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>pancreatic acinar cell</rdfs:label>
