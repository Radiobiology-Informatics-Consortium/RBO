    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000068">
        <obo:IAO_0000115>A unit of concentration which expresses a concentration of a solution of 1 mole per kilogram of solvent (mol/kg).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>m</oboInOwl:hasExactSynonym>
