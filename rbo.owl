    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000178">
        <obo:IAO_0000115>A unit per milliliter unit which is equal to one unit of an agreed arbitrary amount per one milliliter.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>U/ml</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>unit per millilitre</oboInOwl:hasExactSynonym>
