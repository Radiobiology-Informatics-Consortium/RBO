        <owl:annotatedTarget>crista neuralis</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="http://en.wikipedia.org/wiki/Neural_crest"/>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/uberon/core#LATIN"/>
    </owl:Axiom>
