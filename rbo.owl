    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000141">
        <obo:IAO_0000115>An absorbed dose unit which is equal to one millionth of a gray or 10^[-6] Gy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>uGy</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;An absorbed dose unit which is equal to one millionth of a gray or 10^[-6] Gy.&quot; [NIST:NIST]</rdfs:comment>
