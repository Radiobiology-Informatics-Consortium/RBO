        <oboInOwl:hasDbXref>ORCBS:ORCBS</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000150">
        <obo:IAO_0000115>A time unit which is equal to one thousandth of one millionth of a second or 10^[-9] s.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>ns</oboInOwl:hasExactSynonym>
        <rdfs:comment>&quot;A time unit which is equal to one thousandth of one millionth of a second or 10^[-9] s.&quot; [NIST:NIST]</rdfs:comment>
