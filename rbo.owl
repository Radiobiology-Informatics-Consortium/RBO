    <!-- http://purl.obolibrary.org/obo/GO_0098528 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0098528">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GO_0030154"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002315"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0008002"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
