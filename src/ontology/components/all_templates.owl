        <obo:IAO_0000112>The experiment was conducted aboard the International Space Station</obo:IAO_0000112>
        <obo:IAO_0000115>An instance of an Earth-orbiting space station that went operational in the year 2000.</obo:IAO_0000115>
        <obo:IAO_0000117>Jack Miller</obo:IAO_0000117>
        <obo:IAO_0000119>term editor</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym>ISS</oboInOwl:hasExactSynonym>
        <rdfs:label>International Space Station</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000035 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/RBO_00000035">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/RBO_00000046"/>
        <obo:IAO_0000112>The experiment was conducted on the Mir space station</obo:IAO_0000112>
        <obo:IAO_0000115>An instance of an Earth-orbiting space station, operational from1986 to 2001, operated by the Soviet Union and later by Russia.</obo:IAO_0000115>
        <obo:IAO_0000119>Wikipedia</obo:IAO_0000119>
        <rdfs:label>Mir</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000036 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/RBO_00000036">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/RBO_00000033"/>
        <obo:IAO_0000112>The biological payload was carried into orbit by the Space Shuttle</obo:IAO_0000112>
        <obo:IAO_0000115>An instance of a reusable spacecraft designed to carry passengers and equipment into low Earth orbit and return to Earth. Operated by the United States and operational from 1981 to 2011.</obo:IAO_0000115>
        <obo:IAO_0000119>Wikipedia</obo:IAO_0000119>
        <rdfs:label>Space Shuttle</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000037 -->

