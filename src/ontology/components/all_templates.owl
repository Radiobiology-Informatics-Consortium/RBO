        <obo:IAO_0000117>Jack Miller</obo:IAO_0000117>
        <obo:IAO_0000118>x-ray</obo:IAO_0000118>
        <obo:IAO_0000119>http://son.nasa.gov/tass/content/electrospectrum.htm</obo:IAO_0000119>
        <rdfs:label>x-ray radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <obo:IAO_0000115>A material entity which emits radiation</obo:IAO_0000115>
