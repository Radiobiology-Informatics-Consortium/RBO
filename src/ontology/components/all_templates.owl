    <!-- http://purl.obolibrary.org/obo/RBO_00000041 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/RBO_00000041">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/RBO_00000045"/>
        <obo:IAO_0000111>JEM</obo:IAO_0000111>
        <obo:IAO_0000112>The experiment was conducted on the Japanese Experiment Module</obo:IAO_0000112>
        <obo:IAO_0000115>A Japanese science module for the International Space Station developed by JAXA. It is the largest single ISS module, and is attached to the Harmony module. The first two pieces of the module were launched on Space Shuttle missions STS-123 and STS-124.</obo:IAO_0000115>
        <obo:IAO_0000119>Wikipedia</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym>JEM|Kibo</oboInOwl:hasExactSynonym>
        <rdfs:label>ISS-Japanese Experiment Module</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000042 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/RBO_00000042">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/RBO_00000045"/>
