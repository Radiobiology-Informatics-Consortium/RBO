    <!-- http://purl.obolibrary.org/obo/RBO_00000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000116"/>
        <obo:IAO_0000115>Ionizing radiation classified by the material entity which generates or emits it.</obo:IAO_0000115>
        <rdfs:label>ionizing radiation categorized by source</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000001"/>
        <obo:IAO_0000115>Radiation originating outside the Earth&apos;s atmosphere.</obo:IAO_0000115>
        <rdfs:label>space radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000001"/>
        <obo:IAO_0000112>One of the principal sources of ground radiation is radon gas.</obo:IAO_0000112>
        <obo:IAO_0000115>Radiation produced on Earth or on another planetary body by natural or artificial means.</obo:IAO_0000115>
        <rdfs:label>ground radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <obo:IAO_0000115>Material presenting, when irradiated, interaction properties similar to those of soft tissue.</obo:IAO_0000115>
        <obo:IAO_0000119>ICRP glossary (http://icrpaedia.org/Tissue_equivalent_material)</obo:IAO_0000119>
        <rdfs:label>tissue equivalent material</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00005001"/>
        <obo:IAO_0000115>Atomic nuclei, each with 26 protons and 30 neutrons with kinetic energy imparted by natural or artificial means such as by a particle accelerator</obo:IAO_0000115>
        <rdfs:label>Fe-56 ion radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00005001"/>
        <obo:IAO_0000115>Atomic nuclei, each with 6 protons and 6 neutrons with kinetic energy imparted by natural or artificial means such as by a particle accelerator</obo:IAO_0000115>
        <rdfs:label>C-12 ion radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00005001"/>
        <obo:IAO_0000115>Atomic nuclei, each with 14 protons and 14 neutrons with kinetic energy imparted by natural or artificial means such as by a particle accelerator</obo:IAO_0000115>
        <rdfs:label>Si-28 ion radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00005001"/>
        <obo:IAO_0000115>Atomic nuclei, each with 2 protons and 2 neutrons with kinetic energy imparted by natural or artificial means such as by a particle accelerator</obo:IAO_0000115>
        <rdfs:label>He-4 ion radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00005001"/>
        <obo:IAO_0000115>Atomic nuclei, each with 10 protons and 10 neutrons with kinetic energy imparted by natural or artificial means such as by a particle accelerator</obo:IAO_0000115>
        <rdfs:label>Ne-20 ion radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33252"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00005003"/>
        <obo:IAO_0000115>An atomic nucleus, fully stripped of its orbital electrons, and containing 2, 3, 4, 5, or 6 protons.</obo:IAO_0000115>
        <rdfs:label>light ion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000115"/>
        <obo:IAO_0000112>Ionization chambers and silicon solid state detectors can be used as active dosimeters.</obo:IAO_0000112>
        <obo:IAO_0000115>A radiation measuring device which records dose at the time of detection, with data available in real time</obo:IAO_0000115>
        <rdfs:label>active dosimeter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000115"/>
        <obo:IAO_0000112>Thermoluminescent dosimeters and plastic nuclear track detectors are passive detectors.</obo:IAO_0000112>
        <obo:IAO_0000115>A radiation measuring device which integrates the amount of radiation to which it is exposed. Passive detectors are interrogated at a later time to determine the dose.</obo:IAO_0000115>
        <rdfs:label>passive dosimeter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00015038"/>
        <obo:IAO_0000115>The amount of ionizing radiation to which a member of the population on Earth is exposed from natural sources, such as terrestrial radiation from naturally-occurring radionuclides in the soil, cosmic radiation originating in outer space, and naturally-occurring ra</obo:IAO_0000115>
        <rdfs:label>ionizing background radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00010016"/>
        <obo:IAO_0000112>The effective dose was calculated to be 300 mSv.</obo:IAO_0000112>
        <obo:IAO_0000115>The sum of the equivalent doses to all organs in the body, each adjusted to account for the sensitivity of the organ to radiation. Effective dose is calculated for the whole body. Effective dose is expressed in millisieverts (mSv).</obo:IAO_0000115>
        <rdfs:label>effective dose</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000049"/>
        <obo:IAO_0000112>The samples were exposed to a mixed radiation field consisting of several ions at different energies.</obo:IAO_0000112>
        <obo:IAO_0000115>The process of exposing the same sample to more than one type and/or energy of radiation, in sequence or simultaneously.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>mixed field</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mixed radiation field</oboInOwl:hasExactSynonym>
        <rdfs:label>mixed radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000254"/>
        <obo:IAO_0000115>An environment the occupation of which results in exposure to radiation.</obo:IAO_0000115>
        <rdfs:label>radiation environment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000016"/>
        <obo:IAO_0000115>That part of the Earth exposed to the Earth atmosphere.</obo:IAO_0000115>
        <rdfs:label>earth surface</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000016"/>
        <obo:IAO_0000115>The region between the Earth&apos;s surface and an altitude of approximately 100 km</obo:IAO_0000115>
        <rdfs:label>earth atmosphere</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000637"/>
        <obo:IAO_0000111>LEO</obo:IAO_0000111>
        <obo:IAO_0000115>The region of outer space between the Earth&apos;s atmosphere and the innermost Earth radiation belt</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>LEO</oboInOwl:hasExactSynonym>
        <rdfs:label>low earth orbit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000637"/>
        <obo:IAO_0000111>BLEO</obo:IAO_0000111>
        <obo:IAO_0000115>That part of outer space beyond the Earth&apos;s radiation belts.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>BLEO</oboInOwl:hasExactSynonym>
        <rdfs:label>beyond low earth orbit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000021 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00002000"/>
        <obo:IAO_0000111>fractionated</obo:IAO_0000111>
        <obo:IAO_0000115>A radiation dose administered in two or more exposures at specified time intervals</obo:IAO_0000115>
        <rdfs:label>fractionated radiation exposure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000135"/>
        <obo:IAO_0000115>A unit of absorbed dose equal to 1/1000 of a rad</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>mrad</oboInOwl:hasExactSynonym>
        <rdfs:label>millirad</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000023 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00010016"/>
        <obo:IAO_0000112>The equivalent dose was calculated to be 300 mSv.</obo:IAO_0000112>
        <obo:IAO_0000115>The product of the mean absorbed dose in an organ or tissue and the radiation weighting factor (w_R )of the radiation type of interest</obo:IAO_0000115>
        <rdfs:label>equivalent dose</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000024 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00010016"/>
        <obo:IAO_0000112>The total dose was administered in five dose fractions.</obo:IAO_0000112>
        <obo:IAO_0000115>The absorbed radiation dose administered in a single one of a series comprising a fractionated radiation exposure</obo:IAO_0000115>
        <rdfs:label>dose fraction</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000002"/>
        <obo:IAO_0000115>Penetrating ionizing radiation, both particulate and electromagnetic, that originates in outer space</obo:IAO_0000115>
        <rdfs:label>cosmic radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000026"/>
        <obo:IAO_0000112>Galactic cosmic radiation is one of the principal sources of radiation dose outside low-earth orbit</obo:IAO_0000112>
        <obo:IAO_0000115>Galactic cosmic radiation consists of high-energy charged particles originating from outside the solar system</obo:IAO_0000115>
        <rdfs:label>galactic cosmic radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000026"/>
        <obo:IAO_0000112>Solar cosmic radiation contributes to the radiation dose to humans in space.</obo:IAO_0000112>
        <obo:IAO_0000115>Solar cosmic radiation is high-energy charged particles that originate from the sun.</obo:IAO_0000115>
        <rdfs:label>solar cosmic radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000029 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000109"/>
        <obo:IAO_0000112>The dose rate was 0.5 mGy/min.</obo:IAO_0000112>
        <obo:IAO_0000115>The measurement datum representing a dose to an organism or object per unit time.</obo:IAO_0000115>
        <rdfs:label>dose rate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000033 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0001300"/>
        <obo:IAO_0000112>The Apollo spacecraft took 24 astronauts to the Moon between 1968 and 1972.</obo:IAO_0000112>
        <obo:IAO_0000115>Vehicles, crewed or uncrewed, which are designed to orbit about the Earth or another celestial body or be placed into a trajectory to another celestial body or location in space.</obo:IAO_0000115>
        <obo:IAO_0000119>NASA Thesaurus, 1988</obo:IAO_0000119>
        <rdfs:label>spacecraft</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000044 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000044">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000033"/>
        <obo:IAO_0000115>a self-contained unit of a spacecraft</obo:IAO_0000115>
        <rdfs:label>spacecraft module</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000045 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000045">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000044"/>
        <obo:IAO_0000111>ISS module</obo:IAO_0000111>
        <obo:IAO_0000112>The experiment was conducted in the International Space Station module Columbus</obo:IAO_0000112>
        <obo:IAO_0000112>The experiment was conducted on the Russian module of the ISS.</obo:IAO_0000112>
        <obo:IAO_0000115>A self-contained unit of the International Space Station.</obo:IAO_0000115>
        <rdfs:label>international space station module</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000046 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000046">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000033"/>
        <obo:IAO_0000112>Mir was a space station that operated in low Earth orbit from 1986 to 2001, operated by the Soviet Union and later by Russia.</obo:IAO_0000112>
        <obo:IAO_0000115>A spacecraft capable of supporting a human crew in orbit for an extended period of time. It lacks major propulsion or landing systems. Stations must have docking ports to allow other spacecraft to dock to transfer crew and supplies.</obo:IAO_0000115>
        <obo:IAO_0000119>Wikipedia</obo:IAO_0000119>
        <rdfs:label>space station</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000047 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000047">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000121"/>
        <obo:IAO_0000112>The HIMAC accelerator has a beamline dedicated for radiation biology experiments.</obo:IAO_0000112>
        <obo:IAO_0000115>The path leading from a particle accelerator to an experimental station used in experiments in particle physics, materials science, chemistry, and molecular biology, or in irradiation tests or to produce isotopes.</obo:IAO_0000115>
        <obo:IAO_0000119>Wikipedia</obo:IAO_0000119>
        <rdfs:label>particle accelerator beamline</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000049 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000003"/>
        <obo:IAO_0000115>Radiation produced by a particle accelerator.</obo:IAO_0000115>
        <rdfs:label>particle accelerator radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000050 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000050">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000003"/>
        <obo:IAO_0000115>Radiation produced by a nuclear reactor.</obo:IAO_0000115>
        <rdfs:label>nuclear reactor radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000051 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000051">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000120"/>
        <obo:IAO_0000111>Cs-137 gamma</obo:IAO_0000111>
        <obo:IAO_0000115>High energy photons emitted during nuclear decay of the Cesium-137 isotope.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Cs-137</oboInOwl:hasExactSynonym>
        <rdfs:label>cesium-137 gamma radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000052 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000052">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000120"/>
        <obo:IAO_0000111>Co-60 gamma</obo:IAO_0000111>
        <obo:IAO_0000115>High energy photons emitted during nuclear decay of the Cobalt-60 isotope.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Co-60</oboInOwl:hasExactSynonym>
        <rdfs:label>cobalt-60 gamma radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000058 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000058">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000120"/>
        <obo:IAO_0000111>Co-57 gamma</obo:IAO_0000111>
        <obo:IAO_0000115>High energy photons emitted during nuclear decay of the Cobalt-57 isotope.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>obo:RBO_00000060</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Co-57</oboInOwl:hasExactSynonym>
        <rdfs:label>cobalt-57 gamma radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000060 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000060">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33250"/>
        <obo:IAO_0000115>Isotopes that exhibit radioactivity and undergo radioactive decay. (From Grant &amp; Hackh&apos;s Chemical Dictionary, 5th ed &amp; McGraw-Hill Dictionary of Scientific and Technical Terms, 4th ed)</obo:IAO_0000115>
        <obo:IAO_0000119>http://purl.bioontology.org/ontology/MESH/D011868</obo:IAO_0000119>
        <rdfs:label>radionuclide</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000061 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000061">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000060"/>
        <obo:IAO_0000115>A series of radioactive elements from ACTINIUM, atomic number 89, to and including LAWRENCIUM, atomic number 103</obo:IAO_0000115>
        <obo:IAO_0000119>http://purl.bioontology.org/ontology/MESH/D008671</obo:IAO_0000119>
        <rdfs:label>actinide</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000062 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000062">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000061"/>
        <obo:IAO_0000115>A trivalent radioactive element and the prototypical member of the actinide family. It has the atomic symbol Ac, and atomic number 89. Its principal isotope is 227 and it decays primarily by beta-emission.</obo:IAO_0000115>
        <obo:IAO_0000119>http://purl.bioontology.org/ontology/MESH/D000186</obo:IAO_0000119>
        <rdfs:label>actinium</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000063 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000063">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000061"/>
        <obo:IAO_0000115>A completely man-made radioactive actinide with atomic symbol Am, and atomic number 95. Its valence can range from +3 to +6. Because of its nonmagnetic ground state, it is an excellent superconductor. It is also used in bone mineral analysis and as a radiation source for radiotherapy</obo:IAO_0000115>
        <obo:IAO_0000119>http://purl.bioontology.org/ontology/MESH/D000576</obo:IAO_0000119>
        <rdfs:label>americium</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000064 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000064">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000061"/>
        <obo:IAO_0000115>A man-made radioactive actinide with atomic symbol Cf, atomic number 98, and atomic weight 251. Its valence can be +2 or +3. Californium has medical use as a radiation source for radiotherapy</obo:IAO_0000115>
        <obo:IAO_0000119>http://purl.bioontology.org/ontology/MESH/D002142</obo:IAO_0000119>
        <rdfs:label>californium</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000065 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000065">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000061"/>
        <obo:IAO_0000115>A radioactive element of the actinide metals family. It has the atomic symbol Np, and atomic number 93.</obo:IAO_0000115>
        <obo:IAO_0000119>http://purl.bioontology.org/ontology/MESH/D009405</obo:IAO_0000119>
        <rdfs:label>neptunium</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000066 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000066">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000061"/>
        <obo:IAO_0000115>A naturally radioactive element of the actinide metals series. It has the atomic symbol Pu, and atomic number 94. Plutonium is used as a nuclear fuel, to produce radioisotopes for research, in radionuclide batteries for pacemakers, and as the agent of fission in nuclear weapons.</obo:IAO_0000115>
        <obo:IAO_0000119>http://purl.bioontology.org/ontology/MESH/D011005</obo:IAO_0000119>
        <rdfs:label>plutonium</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000067 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000067">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000061"/>
        <obo:IAO_0000115>A radioactive element of the actinide series of metals. It has an atomic symbol Th, atomic number 90, and atomic weight 232.04. It is used as fuel in nuclear reactors to produce fissionable uranium isotopes. Because of its radioopacity, various thorium compounds are used to facilitate visualization in roentgenography.</obo:IAO_0000115>
        <obo:IAO_0000119>http://purl.bioontology.org/ontology/MESH/D013910</obo:IAO_0000119>
        <rdfs:label>thorium</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000068 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000068">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000061"/>
        <obo:IAO_0000115>A radioactive element of the actinide series of metals. It has an atomic symbol U, atomic number 92, and atomic weight 238.03. U-235 is used as the fissionable fuel in nuclear weapons and as fuel in nuclear power reactors.</obo:IAO_0000115>
        <obo:IAO_0000119>http://purl.bioontology.org/ontology/MESH/D014501</obo:IAO_0000119>
        <rdfs:label>uranium</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000069 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000069">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000114"/>
        <obo:IAO_0000111>UV</obo:IAO_0000111>
        <obo:IAO_0000115>Electromagnetic radiation with photon energies approximately 3-120 eV. High energy UV radiation can be ioinizing.</obo:IAO_0000115>
        <obo:IAO_0000118>UV radiation</obo:IAO_0000118>
        <obo:IAO_0000119>http://son.nasa.gov/tass/content/electrospectrum.htm</obo:IAO_0000119>
        <rdfs:label>ultraviolet radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000070 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000070">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24432"/>
        <obo:IAO_0000111>radioprotector</obo:IAO_0000111>
        <obo:IAO_0000112>E.G. amifostine.</obo:IAO_0000112>
        <obo:IAO_0000115>A substance present at the time of irradiation that mitigates or prevents the biological effects of irradiation.</obo:IAO_0000115>
        <obo:IAO_0000119>Richard T. Hoppe, Theodore Locke Phillips, Mack Roach, Leibel and Phillips Textbook of Radiation Oncology (Third Edition), W.B. Saunders, (2010), ISBN 9781416058977, https://doi.org/10.1016/B978-1-4160-5897-7.00093-7.</obo:IAO_0000119>
        <rdfs:label>radioprotectant</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000071 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000071">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24432"/>
        <obo:IAO_0000115>Radionuclide chelators are small organic molecules or in some cases larger peptides that chemically sequester the radionuclide ion by forming a complex that determines the thermodynamic stability and kinetic inertness of the radionuclide.</obo:IAO_0000115>
        <rdfs:label>radionuclide chelator</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000072 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000072">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24432"/>
        <obo:IAO_0000115>A co-carcinogen is generally a chemical  that promotes the effects of a carcinogen in the production of cancer. In some circumstances exposure to radiation or physical trauma is considered to be co-carcinogenic.</obo:IAO_0000115>
        <rdfs:label>co-carcinogen</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000073 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000073">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24432"/>
        <obo:IAO_0000115>Radiation response modifiers are agents that alter tumor or normal tissue response to radiation, such as radiation sensitizers and radiation protectors. </obo:IAO_0000115>
        <obo:IAO_0000119>Citrin DE, Mitchell JB. Altering the response to radiation: sensitizers and protectors. Semin Oncol. 2014 Dec;41(6):848-59. doi: 10.1053/j.seminoncol.2014.09.013. Epub 2014 Oct 7. PMID: 25499642; PMCID: PMC4270009.</obo:IAO_0000119>
        <rdfs:label>radiation response modifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000074 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000074">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000073"/>
        <obo:IAO_0000115>Radiation response modifiers that are peptides.</obo:IAO_0000115>
        <obo:IAO_0000119>Shaghaghi, Zahra et al. â€œPotential utility of peptides against damage induced by ionizing radiation.â€ Future oncology (2021): doi/10.2217/fon-2020-0577</obo:IAO_0000119>
        <rdfs:label>peptide radiation response modifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000075 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000075">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000073"/>
        <obo:IAO_0000115>Radiation response modifiers that are small molecules.</obo:IAO_0000115>
        <rdfs:label>small molecule radiation response modifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000076 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000076">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000111"/>
        <obo:IAO_0000115>A person employed or otherwise working in commercial activities where nuclear materials are created, handled or disposed and at risk of occupational radiation exposure. Excludes health workers.</obo:IAO_0000115>
        <obo:IAO_0000119>Nezahat Hunter, Richard G.E. Haylock, Michael Gillies, Wei Zhang; Extended analysis of solid cancer incidence among the Nuclear Industry Workers in the UK: 1955â€“2011. Radiat Res 2022; doi: https://doi.org/10.1667/RADE-20-00269.1</obo:IAO_0000119>
        <rdfs:label>nuclear industry worker</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00000077 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00000077">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000111"/>
        <rdfs:label>astronaut</rdfs:label>
    </owl:Class>
    


