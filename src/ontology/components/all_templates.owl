    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00000117"/>
        <obo:IAO_0000115>Atomic nuclei, variously defined as having atomic number 2, 3, 4, 5 or 6 and kinetic energy imparted by natural or artificial means</obo:IAO_0000115>
        <rdfs:label>light ion radiation</rdfs:label>
    </owl:Class>
    


