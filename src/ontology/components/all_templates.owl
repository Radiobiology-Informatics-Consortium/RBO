    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005050 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005050">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00010012"/>
        <obo:IAO_0000115>An atomic nucleus with 54 protons and 75 neutrons </obo:IAO_0000115>
        <obo:IAO_0000118>Xe-129 ion;Xe-129 nucleus;Xe-129 </obo:IAO_0000118>
        <rdfs:label>Xenon-129 nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/RBO_00005051 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/RBO_00005051">
