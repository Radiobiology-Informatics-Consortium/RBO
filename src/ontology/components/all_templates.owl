    <!-- http://purl.obolibrary.org/obo/RBO_00010021 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/RBO_00010021">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/OBI_0302889"/>
